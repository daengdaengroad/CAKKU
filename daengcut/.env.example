# ─────────────────────────────────────────────
# 댕컷(DaengCut) 환경변수
#
# 보통은 이 파일을 건드릴 필요가 없습니다.
# API 키와 목소리는 프로그램을 켠 뒤 화면의 [⚙ 설정] 에서 넣는 게 더 쉽고,
# 그렇게 넣은 값이 이 파일보다 우선합니다.
#
# 이 파일은 서버에 올려 돌리거나, 여러 대에 같은 설정을 심을 때 씁니다.
# ─────────────────────────────────────────────

# 서버 포트
PORT=4000

# 작업 디렉터리 (원본/중간산출물/결과물이 쌓이는 곳)
DAENGCUT_WORKSPACE=./workspace

# ── AI 대본 (필수) ────────────────────────────
# https://console.anthropic.com 에서 발급
ANTHROPIC_API_KEY=

# 대본/비전 분석에 쓸 모델
ANTHROPIC_MODEL=claude-opus-5

# ── TTS 내레이션 (선택) ───────────────────────
# google | elevenlabs | openai | none
TTS_PROVIDER=none

# google TTS: GCP 서비스계정 JSON 경로 (YouTube와 같은 프로젝트 써도 됨)
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_TTS_VOICE=ko-KR-Chirp3-HD-Leda

# elevenlabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# openai
OPENAI_API_KEY=
OPENAI_TTS_VOICE=nova

# ── 유튜브 자동 업로드 (선택) ─────────────────
# Google Cloud Console > OAuth 2.0 클라이언트 ID (데스크톱/웹)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:4000/api/youtube/callback

# ── 바이너리 경로 (보통 비워두면 번들된 걸 씀) ──
FFMPEG_PATH=
FFPROBE_PATH=
