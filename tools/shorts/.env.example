# 구글 Cloud Text-to-Speech API 키 (필수: 실제 목소리를 넣으려면)
# https://console.cloud.google.com > API 및 서비스 > Cloud Text-to-Speech API 사용 설정 > API 키 발급
GOOGLE_TTS_API_KEY=

# 대본 생성용 (둘 중 하나만 있으면 된다. 없으면 템플릿 대본으로 돌아간다)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# 선택: 목소리와 말 속도
TTS_VOICE=ko-KR-Neural2-C
TTS_SPEAKING_RATE=1.05

# 선택: 자막 폰트 (기본값은 설치된 나눔 계열을 자동 탐색)
# SHORTS_FONT=NanumSquareRound
